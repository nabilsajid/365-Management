# Supabase project (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Needed for inviting employees and for `npm run seed:demo`.
SUPABASE_SERVICE_ROLE_KEY=

# Demo organization and its single admin user, created by `npm run seed:demo`.
DEMO_ORG_NAME=Demo Studio
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# Shared password for the demo employees listed in scripts/demo-team.json.
# Leave empty to skip creating them.
DEMO_EMPLOYEE_PASSWORD=

# Postgres connection string, only for `npm run test:db`.
DATABASE_URL=
